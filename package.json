{
  "name": "bannerbender",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "node start-electron.js",
    "buildmacos": "electron-packager . BannerBender --platform=darwin --arch=x64 --out=dist --overwrite",
    "buildwin": "electron-packager . BannerBender --platform=win32 --arch=x64 --out=dist --ignore=\"^/(dist|node_modules)\" --overwrite --asar"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YouTube-101/BannerBender.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/YouTube-101/BannerBender/issues"
  },
  "homepage": "https://github.com/YouTube-101/BannerBender#readme",
  "devDependencies": {
    "electron": "43.2.0",
    "electron-packager": "15.4.0"
  },
  "build": {
    "appId": "com.ytube101.lastpotatos.bannerbender",
    "productName": "BannerBender",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "loading.html",
      "style.css",
      "script.js",
      "preload.js",
      "package.json",
      "sabanci_courses.csv"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  }
}
