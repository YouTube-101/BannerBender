{
  "name": "bannerbender",
  "version": "2026.09.16.1",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "node start-electron.js",
    "buildmacos": "electron-packager . BannerBender --platform=darwin --arch=x64 --out=dist --overwrite",
    "buildwin": "electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YouTube-101/BannerBender.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/YouTube-101/BannerBender/issues"
  },
  "homepage": "https://github.com/YouTube-101/BannerBender#readme",
  "devDependencies": {
    "electron": "^43.6.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.ytube101.lastpotatos.bannerbender",
    "productName": "BannerBender",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "loading.html",
      "style.css",
      "script.js",
      "preload.js",
      "package.json",
      "sabanci_courses.csv"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "electron-store": "^11.0.2",
    "tough-cookie": "^6.0.2"
  }
}
